# Server-side Postgres connection string for the Next.js app.
# Use Supabase Dashboard -> Project Settings -> Database -> Connection string.
# Do not use anon or service_role API keys for migrations.
DATABASE_URL=

# Direct/session Postgres URL for the pipeline CLI (hosted Supabase).
# Required for any DB write; there is no local Supabase workflow.
# Every write targets the live database and needs explicit approval of the
# exact hosted target before running.
SUPABASE_DB_URL=

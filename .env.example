# Server-side Postgres connection string for the Next.js app.
# Use Supabase Dashboard -> Project Settings -> Database -> Connection string.
# Do not use anon or service_role API keys for migrations.
DATABASE_URL=

# Direct/session Postgres URL for the pipeline CLI (hosted Supabase).
# Required for any DB write; there is no local Supabase workflow.
# Every write targets the live database and needs explicit approval of the
# exact hosted target before running.
SUPABASE_DB_URL=

# Server-only shared team access. Keep hashes and signing material in the
# deployment environment; never commit real values. TEAM_PASSWORD_HASHES_JSON
# entries use: {"team-id":{"hash":"urc$scrypt$v1$...","sessionVersion":1}}
TEAM_PASSWORD_HASHES_JSON=
# Base64url encoding of exactly 32 random bytes. Rotating it invalidates all
# existing team sessions; increment one team's sessionVersion to invalidate only it.
TEAM_SESSION_SIGNING_KEY=
TEAM_SESSION_TTL_SECONDS=

# Set to true only after the Vercel WAF rate-limit rule protects
# POST /api/team-session/unlock. Unlock fails closed with 503 otherwise.
TEAM_UNLOCK_RATE_LIMIT_ENFORCED=false

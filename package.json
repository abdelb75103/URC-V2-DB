{
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:dashboard-access": "node --test tests/team-dashboard-access.test.mjs tests/league-dashboard-access.test.mjs tests/dashboard-tab.test.mjs tests/season-comparison-ui.test.mjs && tsx --test tests/season-timeline.test.ts tests/season-comparison-presentation.test.ts",
    "test:dashboard-v3": "node --test tests/dashboard-v3-validation.test.mjs && python3 tests/test_dashboard_v3_preview.py",
    "test:reports": "tsx --conditions=react-server --test tests/report-model.test.ts tests/report-severity.test.ts && tsx --conditions=react-server --test tests/report-pdf.test.tsx && node --test tests/report-boundary.test.mjs",
    "reports:render-fixtures": "tsx --conditions=react-server scripts/render-report-fixtures.tsx",
    "pipeline": "python3 -m pipeline",
    "pipeline:check": "python3 -m pipeline self-check",
    "pipeline:alias-check": "python3 -m pipeline validate-alias-map",
